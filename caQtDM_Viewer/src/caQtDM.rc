#include <Winver.h>
IDI_ICON1               ICON    DISCARDABLE     "caQtDM.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TARGET_VER_MAJ,TARGET_VER_MIN,TARGET_VER_BUILD,0
 PRODUCTVERSION TARGET_VER_MAJ,TARGET_VER_MIN,TARGET_VER_BUILD,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_UNKNOWN
 FILESUBTYPE 0x0L

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
#ifdef CAQTDM_MINGW_RESOURCE_COMPAT
            VALUE "CompanyName",        "Paul Scherrer Institut"
            VALUE "FileDescription",    "Channel Access Qt Display Manager"
            VALUE "FileVersion",        "V4.9.0"
            VALUE "InternalName",       "caqtdm"
            VALUE "LegalCopyright",     "Copyright (C) 2012-2025 Paul Scherrer Institut"
            VALUE "OriginalFilename",   "caqtdm.exe"
            VALUE "ProductName",        "Channel Access Qt Display Manager"
            VALUE "ProductVersion",     "V4.9.0"
#else
            VALUE "CompanyName",        TARGET_COMPANY
            VALUE "FileDescription",    TARGET_PRODUCT
            VALUE "FileVersion",        TARGET_VERSION_STR
            VALUE "InternalName",       TARGET_INTERNALNAME
            VALUE "LegalCopyright",     TARGET_COPYRIGHT
            VALUE "OriginalFilename",   TARGET_FILENAME
            VALUE "ProductName",        TARGET_DESCRIPTION
            VALUE "ProductVersion",     TARGET_VERSION_STR
#endif
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
