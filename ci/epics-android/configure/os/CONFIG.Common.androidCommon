# CONFIG.Common.androidCommon
#
# This file is maintained by the build community.
#
# Definitions for all Apple iOS builds
# Sites may override these definitions in CONFIG_SITE.Common.androidCommon
# or CONFIG_SITE.<host>.iosCommon
#-------------------------------------------------------

# Include definitions common to all Unix targets
include $(CONFIG)/os/CONFIG.Common.UnixCommon

# Include common gnu compiler definitions
include $(CONFIG)/CONFIG.gnuCommon

#-------------------------------------------------------
# Valid build types
VALID_BUILDS = Ioc

#-------------------------------------------------------
# operating system class (include/os/<os_class>)
OS_CLASS = android
NDK = /opt/android-sdk/ndk/29.0.14206865
ABI = 29
#--------------------------------------------------
GNU_DIR=$(NDK)/toolchains/llvm/prebuilt/linux-x86_64
#GNU_TARGET=arm-linux-androideabi arm64-v8a armeabi-v7a
GNU_BIN=$(GNU_DIR)/bin

#-------------------------------------------------------
# Build architecture flags
#
# Android Clang selects architecture through --target, not -arch.
# Keep these empty to avoid passing Darwin-style -arch flags.
ARCH_DEP_FLAGS =
ARCH_DEP_CFLAGS += $(ARCH_DEP_FLAGS)
ARCH_DEP_LDFLAGS += $(ARCH_DEP_FLAGS)

#--------------------------------------------------
# Operating system flags
SDK_DIR = $(GNU_DIR)/sysroot
OP_SYS_CFLAGS += -isysroot $(SDK_DIR)
OP_SYS_LDFLAGS += -isysroot $(SDK_DIR)

#--------------------------------------------------
# Always compile in debugging symbol table information
#
OPT_CFLAGS_YES += -g
OPT_CXXFLAGS_YES += -g

#-------------------------------------------------------
# Compiler definitions:

CC_CLANG  = clang
CCC_CLANG = clang++

CMPLR_CLASS = clang

#--------------------------------------------------
# code flags

#CFLAGS        = -Wno-psabi -march=armv7-a -mfloat-abi=softfp -mfpu=vfp -ffunction-sections -funwind-tables -fstack-protector -fno-short-enums -DANDROID -Wa,--noexecstack -Os -fomit-frame-pointer -fno-strict-aliasing -mthumb -Wall -Wno-psabi -W -D_REENTRANT -fPIC 
#CXXFLAGS      = -Wno-psabi -march=armv7-a -mfloat-abi=softfp -mfpu=vfp -ffunction-sections -funwind-tables -fstack-protector -fno-short-enums -DANDROID -Wa,--noexecstack -std=gnu++0x -O2 -Os -fomit-frame-pointer -fno-strict-aliasing -mthumb -Wall -Wno-psabi -W -D_REENTRANT -fPIC -fno-use-cxa-atexit

#CFLAGS        = -march=$(ARCH_CLASS) -fPIC
#CXXFLAGS      = -march=$(ARCH_CLASS) -fPIC
CFLAGS        = -fPIC
CXXFLAGS      = -fPIC

#-------------------------------------------------------
# Linker flags
GNU_LDLIBS_YES =

OP_SYS_LDFLAGS +=  --sysroot=$(NDK)/toolchains/llvm/prebuilt/linux-x86_64/sysroot 

#-march=armv7-a -Wl,--fix-cortex-a8


#--------------------------------------------------
# Header dependency file generation
#
HDEPENDS_METHOD = CMD

#--------------------------------------------------
# Allow site overrides
#-include $(CONFIG)/os/CONFIG_SITE.Common.androidCommon
#-include $(CONFIG)/os/CONFIG_SITE.$(EPICS_HOST_ARCH).androidCommon

AR            = $(GNU_BIN)/llvm-ar cqs
RANLIB        = $(GNU_BIN)/llvm-ranlib
LD            = $(GNU_BIN)/llvm-ld
CC            = $(GNU_BIN)/$(TARGET)$(ABI)-clang
CCC           = $(GNU_BIN)/$(TARGET)$(ABI)-clang++


