{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../caqtdm-build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CAQTDM_BUILD_GPS": "ON",
                "CAQTDM_BUILD_MODBUS": "ON",
                "CAQTDM_BUILD_OPCUA": "ON"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "caQtDM Linux Debug",
            "binaryDir": "${sourceDir}/../caqtdm-build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "caQtDM Linux Release (RelWithDebInfo, like qmake -g)",
            "binaryDir": "${sourceDir}/../caqtdm-build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        }
    ],
    "testPresets": [
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "output": { "outputOnFailure": true },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "output": { "outputOnFailure": true },
            "environment": {
                "QT_QPA_PLATFORM": "offscreen"
            }
        }
    ]
}
